# Copy this file to .env and fill in real values.
# NEVER commit the real .env file or expose these keys to frontend JS.

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-string
FLASK_ENV=development

# Web search provider. "auto" needs NO key — it resolves the query to a
# real Wikipedia article and verifies every link before showing it.
# Set a real provider + key below for broader web/PDF/video coverage.
SEARCH_API_KEY=
SEARCH_API_PROVIDER=auto
# auto (free, no key) | brave | serper | tavily | bing

# AI provider. "auto" needs NO key — it builds study notes directly from
# the retrieved article text (see SEARCH_API_PROVIDER above).
AI_API_KEY=
AI_API_PROVIDER=auto
# auto (free, derives notes from retrieved source text) | anthropic

# Database
DATABASE_URL=sqlite:///student_hub.db
